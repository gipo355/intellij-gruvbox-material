<idea-plugin>
    <id>dev.gipo.gruvboxmaterial</id>
    <name>Gruvbox Material Islands</name>
    <vendor url="https://github.com/gipo355/intellij-gruvbox-material">gipo355</vendor>
    <description><![CDATA[
        <p>A warm, low-glare theme: the gruvbox-material palette (material foreground) on JetBrains'
        Islands layout, in four variants: dark soft, medium and hard, and light soft.</p>

        <ul>
            <li><b>Warm syntax</b>: no blue in code, no bold or italic, nothing contrasts more with the background than the text.</li>
            <li><b>Moderate contrast</b>: 6.7:1 to 9.1:1 for text on the background, by variant.</li>
            <li><b>Dim tints</b> for search results, diffs and usages instead of bright blocks.</li>
            <li><b>Complete scheme</b>: every editor key the IDE and its plugins define is set.</li>
            <li><b>Islands layout</b>: the 2026 JetBrains UI, recolored.</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <themeProvider id="f869fff9-c7e3-4656-b344-d228bf76a6c3" path="/themes/GruvboxMaterialIslands.theme.json"/>
        <themeProvider id="275611fd-a504-467e-9c31-f0470ba50762" path="/themes/GruvboxMaterialIslandsMedium.theme.json"/>
        <themeProvider id="117eb1e1-e632-4fba-b735-691361c815df" path="/themes/GruvboxMaterialIslandsHard.theme.json"/>
        <themeProvider id="653f45a7-3ec3-431d-a49e-dfba1290c9bf" path="/themes/GruvboxMaterialIslandsLight.theme.json"/>
    </extensions>

    <!-- Settings: readability, accent, tabs, reading font, toolbar chip. -->
    <depends optional="true" config-file="gruvbox-indent-rainbow.xml">indent-rainbow.indent-rainbow</depends>
    <!-- null / true / false (and undefined) in the predefined-symbol purple. -->
    <depends optional="true" config-file="gruvbox-java.xml">com.intellij.java</depends>
    <depends optional="true" config-file="gruvbox-kotlin.xml">org.jetbrains.kotlin</depends>
    <depends optional="true" config-file="gruvbox-javascript.xml">JavaScript</depends>
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="true" supportsK2="true"/>
    </extensions>
    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable parentId="appearance" id="dev.gipo.gruvboxmaterial.settings" displayName="Gruvbox Material"
                                 instance="dev.gipo.gruvboxmaterial.settings.GruvboxConfigurable"/>
        <postStartupActivity implementation="dev.gipo.gruvboxmaterial.settings.GruvboxStartup"/>
    </extensions>
    <applicationListeners>
        <listener class="dev.gipo.gruvboxmaterial.settings.GruvboxListener" topic="com.intellij.ide.ui.LafManagerListener"/>
        <listener class="dev.gipo.gruvboxmaterial.settings.GruvboxListener" topic="com.intellij.openapi.editor.colors.EditorColorsListener"/>
        <listener class="dev.gipo.gruvboxmaterial.settings.GruvboxListener" topic="com.intellij.ide.AppLifecycleListener"/>
    </applicationListeners>
    <actions>
        <action id="GruvboxMaterial.Chip" class="dev.gipo.gruvboxmaterial.settings.GruvboxChipAction" icon="AllIcons.Actions.Colors"
                text="Gruvbox Material" description="Variant, readability toggles, accent and reading font">
            <add-to-group group-id="MainToolbarRight" anchor="first"/>
        </action>
    </actions>
</idea-plugin>
